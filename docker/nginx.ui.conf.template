# 前端容器的 nginx 站点配置模板。占位符由 scripts/run_ui.sh 用 sed 替换：
#   __LISTEN_PORT__   监听端口（环境变量 LISTEN_PORT）
#   __GATEWAY_URL__   后端网关地址（环境变量 GATEWAY_URL）
# 本文件被 include 进 nginx 的 http 段，所以开头的 map 是合法的。

# WebSocket 升级握手：非 WS 请求时要把 Connection 置为 close，写死 "upgrade" 会打断普通 keepalive
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen __LISTEN_PORT__;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 不能在这里写 types {} 去补 .mjs：低层级的 types 块是整体覆盖而不是追加，
    # 一旦写了，nginx.conf 里 http 段的 include mime.types 就全部作废，
    # html/js/css 都不认识、一律按 default_type 发 application/octet-stream，
    # 浏览器会把首页当文件下载、模块脚本也因 MIME 不对被拒执行。
    # 下面只给 .mjs 单独一条 location 改默认类型，其余类型继续用镜像自带的 mime.types。

    # 单页应用：静态资源直出，路由交给前端（hash 模式，history 模式也靠这条兜底）
    location / {
        try_files $uri $uri/ /index.html;
        # index.html 不能缓存，否则发版后浏览器还拿着旧的资源清单
        add_header Cache-Control "no-store";
    }

    # 正则 location 按出现顺序取首个命中，所以 .mjs 这条要写在下面的强缓存之前，
    # 否则 /mjs/ 目录下的文件会先被目录规则接走、拿不到正确类型。
    # 基础镜像的 mime.types 不一定收录 .mjs，这里显式补上类型并跟着走长缓存。
    location ~* \.mjs$ {
        default_type application/javascript;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 带内容 hash 的构建产物可以长期强缓存。目录名由 vben 的 vite 配置决定
    # （entryFileNames=jse/、chunkFileNames=js/、assetFileNames=[ext]/），
    # 所以这里按目录枚举而不是写死 /assets/（原来那条 /assets/ 在这套产物里一个也匹不到，
    # 强缓存从未生效）；根目录的 index.html / favicon.ico / print-lock.css / _app.config.js
    # 不带 hash，仍走上面的 no-store。/api/ 不会被这些模式匹到。
    location ~* ^/(jse|js|css|assets|img|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|mp4|webm)/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 后端统一入口。前端只发 /api/**，这里整段透传给网关（保留 /api 前缀，
    # 网关路由规范是 /api/{service_name}/{path}）
    location /api/ {
        proxy_pass __GATEWAY_URL__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # 工作流调试用 WebSocket / SSE 推事件：必须关缓冲，否则 nginx 会把事件攒到
        # 响应结束才吐，前端看到的就是一坨而不是实时流
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        # 长任务（含等待审批挂起）不能被 nginx 先掐断
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # 工作流文件上传上限，和后端 MAX_DOC_SIZE(50MB) 留出余量
        client_max_body_size 100m;
    }

    # vite 构建已产出 .gz（VITE_COMPRESS=gzip），有预压缩文件就直接发，省 CPU
    gzip_static on;
    gzip_vary on;
}

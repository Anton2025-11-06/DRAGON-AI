FROM lpshubd8c3xdtgach7.xuanyuan.run/library/python:3.12.15-slim

# 1. 替换 Debian apt 源为清华源（安全源 security.debian.org 也一并替换）
RUN sed -i -e 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
           -e 's|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
           /etc/apt/sources.list.d/debian.sources

# 2. 预装系统依赖：原有 + nodejs 编译/运行依赖 + playwright系统库
# playwright 浏览器运行依赖：libnss3 libatk-bridge2.0-0 libdrm2 libxkbcommon0 libgtk-4-1 libnspr4 libasound2 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libu2f-udev
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        fonts-noto-cjk \
        fonts-wqy-zenhei \
        ripgrep \
        # nodejs 前置依赖
        gnupg \
        # playwright 浏览器系统依赖
        libnss3 libatk-bridge2.0-0 libdrm2 libxkbcommon0 libgtk-4-1 libnspr4 libasound2 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libu2f-udev \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 3. 安装 Node.js（推荐 20 LTS，国内源）
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# 校验 node / npm
RUN node -v && npm -v

# 4. 装 uv（用系统 pip 引导即可）
RUN pip install -i https://pypi.tuna.tsinghua.edu.cn/simple uv
RUN uv --version

# ========== 构建阶段直接创建固定路径 venv，安装全部依赖 ==========
ENV GATEWAY_VENV=/root/.agentscope/.venv
ENV GATEWAY_PYTHON=/usr/local/bin/python

RUN uv venv --python ${GATEWAY_PYTHON} ${GATEWAY_VENV}

# 往 venv 里装包：mcp<2.0.0 uvicorn fastapi httpx + playwright
RUN uv pip install --python ${GATEWAY_VENV}/bin/python \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        "mcp<2.0.0" uvicorn fastapi httpx playwright Pillow python-pptx pandas numpy pypdf python-docx openpyxl pyinstaller

# agentscope 指定版本
RUN uv pip install --python ${GATEWAY_VENV}/bin/python \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        "agentscope==2.0.9"

# ✅ 关键一步：在venv内执行 playwright install 下载浏览器二进制
ENV PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN ${GATEWAY_VENV}/bin/playwright install chromium

# docker build -f customSandbox.file -t sandbox-python:3.12.15-slim-full-pre-v2 .
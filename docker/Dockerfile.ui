# 前端镜像：node 构建出静态产物，nginx 托管并把 /api 反代到网关。
#
# 构建上下文是仓库根目录，靠 docker/Dockerfile.ui.dockerignore 只放
# ui-ai / scripts / docker 三项进上下文（需要 BuildKit，Docker 23+ 默认开启）：
#   docker build -f docker/Dockerfile.ui -t dragon-ai-ui:latest .
#
# 运行：
#   docker run -d -p 8080:80 -e GATEWAY_URL=http://10.0.0.9:18000 dragon-ai-ui:latest

FROM node:22-slim AS builder

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NODE_OPTIONS=--max-old-space-size=8192 \
    COREPACK_NPM_REGISTRY=https://registry.npmmirror.com \
    TURBO_TELEMETRY_DISABLED=1

WORKDIR /app

# 前端是 pnpm workspace monorepo，内部包之间用 workspace 协议互相依赖，
# 拆不出「只拷 lockfile」的一层，只能整个 ui-ai 拷进来（依赖层缓存因此少一些）
COPY ui-ai/ ./

# 装依赖：registry 已锁在 ui-ai/.npmrc（npmmirror）；pnpm 版本走 package.json 的
# packageManager 字段（pnpm@10.22.0），与 lockfile 同源。node:22 不一定还自带 corepack，显式装
RUN npm i -g corepack --registry=https://registry.npmmirror.com \
    && corepack enable \
    && pnpm install --frozen-lockfile

# 只构建 apps/web-antd 这一个应用，产物在 ui-ai/apps/web-antd/dist
RUN pnpm run build:antd

FROM nginx:stable-alpine AS production

# 构建产物：nginx 站点根
COPY --from=builder /app/apps/web-antd/dist /usr/share/nginx/html

# 站点配置模板（__GATEWAY_URL__ / __LISTEN_PORT__ 由启动脚本替换）与启动脚本
COPY docker/nginx.ui.conf.template /etc/nginx/ui.conf.template
COPY scripts/run_ui.sh /usr/local/bin/run_ui.sh

# 覆盖基础镜像自带的 default.conf（它也在监听 80，留着会抢站点）
RUN rm -f /etc/nginx/conf.d/default.conf \
    && sed -i 's/\r$//' /usr/local/bin/run_ui.sh \
    && chmod +x /usr/local/bin/run_ui.sh

EXPOSE 80
CMD ["/usr/local/bin/run_ui.sh"]

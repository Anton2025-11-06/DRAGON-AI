# docker compose 的变量样例：复制成 docker/.env 后按环境填值。
# compose 会自动读同目录的 .env，不用每次 NACOS_ADDR=xxx 前缀。

# 注册中心 + 配置中心（必填，所有业务配置都在 Nacos 里）
NACOS_ADDR=127.0.0.1:8848
NACOS_NAME=nacos
NACOS_PASSWD=Jzh@616294
# 命名空间 ID，留空 = public
NACOS_NS_ID=dragon-ai

# 每个微服务的 gunicorn worker 数
WORKERS=4
# arq worker 进程数 / 本实例消费的队列切片号（workflow 流水线）
ARQ_WORKERS=1
SPLIT_NUMBER=1

# ragflow（知识库摄取）流水线：与上面两个变量分开调，两条队列互不偷任务
RAG_ARQ_WORKERS=1
RAG_SPLIT_NUMBER=1

GRAPH_ARQ_WORKERS=1
GRAPH_SPLIT_NUMBER=1

# 镜像 tag 与对外端口
TAG=latest
GATEWAY_PORT=18000
UI_PORT=12345

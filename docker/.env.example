# docker compose 的变量样例：复制成 docker/.env 后按环境填值。
# compose 会自动读同目录的 .env，不用每次 NACOS_ADDR=xxx 前缀。

# 注册中心 + 配置中心（必填，所有业务配置都在 Nacos 里）
NACOS_ADDR=127.0.0.1:8848
NACOS_NAME=nacos
NACOS_PASSWD=
# 命名空间 ID，留空 = public
NACOS_NS_ID=

# 每个微服务的 gunicorn worker 数
WORKERS=4
# arq worker 进程数 / 本实例消费的队列切片号
ARQ_WORKERS=4
SPLIT_NUMBER=1

# 镜像 tag 与对外端口
TAG=latest
GATEWAY_PORT=18000
UI_PORT=8080

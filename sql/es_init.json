{
  "settings": {
    "number_of_shards": 4,
    "number_of_replicas": 1,
    "refresh_interval": "1s",
    "index.knn": true
  },
  "mappings": {
    "properties": {
      "dept_id": {
        "type": "long"
      },
      "kb_id": {
        "type": "long"
      },
      "doc_id": {
        "type": "long"
      },
      "chunk_index": {
        "type": "integer",
        "description": "该文档内分片序号"
      },
      "chunk_text": {
        "type": "text",
        "analyzer": "ik_max_word",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "chunk_vector": {
        "type": "dense_vector",
        "dims": 1024,
        "index": true,
        "similarity": "cosine"
      },
      "token_count": {
        "type": "integer",
        "description": "分片token数量，用于截断控制"
      },
      "is_deleted": {
        "type": "boolean",
        "default": false,
        "description": "软删标记，对账使用；检索过滤is_deleted:false"
      },
      "creator": {
        "type": "long",
        "description": "创建人user_id"
      },
      "create_at": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd||epoch_millis"
      }
    }
  }
}
